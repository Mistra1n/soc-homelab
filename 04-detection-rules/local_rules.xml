<!-- Custom Wazuh rules for the SOC homelab.
     Copy to /var/ossec/etc/rules/local_rules.xml on the Wazuh server, then:
       systemctl restart wazuh-manager
     Rule IDs 100000-120000 are reserved for custom rules. -->
<group name="local,homelab,">

  <!-- Brute force: 5+ failed Windows logons from one source within 2 minutes.
       Built on the built-in rule 60122 (Windows logon failure). -->
  <rule id="100001" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Possible brute force: 5+ failed logons in 2 minutes from the same source</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
